{
  "name": "spes",
  "version": "2.5.0",
  "description": "DOLE SPES Portal web application",
  "author": "DOLE SPES",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run version:patch && vite build",
    "version:patch": "node scripts/custom-version.mjs && node scripts/sync-version.mjs",
    "postversion": "node scripts/sync-version.mjs",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version",
    "preview": "vite preview",
    "preview:lan": "vite preview --host 0.0.0.0 --port 5173 --strictPort"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.4",
    "@tailwindcss/vite": "^4.2.4",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.13",
    "tailwindcss": "^4.2.4",
    "vite": "^8.0.10"
  },
  "dependencies": {
    "@rbac/rbac": "^2.1.3",
    "@supabase/supabase-js": "^2.105.1",
    "apexcharts": "^3.46.0",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "flowbite": "^4.0.1",
    "pg": "^8.21.0",
    "sweetalert2": "^11.26.24"
  }
}
