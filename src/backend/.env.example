# ═══════════════════════════════════════════════════════════════
# SPES Portal — Environment Configuration Example (Unified)
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ═══════════════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0

# ── Supabase (Frontend — Portal Unified Instance) ─────────────
VITE_SUPABASE_URL=https://byrmafeczbxutgkicmtu.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key
VITE_SUPABASE_SCHEMA=spes

# ── Supabase (Backend — Direct DB Connection) ────────────────
SUPABASE_DB_URL="postgresql://postgres.byrmafeczbxutgkicmtu:YOUR-PASSWORD@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres?options=--search_path%3Dspes,public"

# ── Supabase (Service Role & Secrets) ────────────────────────
SUPABASE_URL=https://byrmafeczbxutgkicmtu.supabase.co
SUPABASE_SERVICE_ROLE=your-service-role-key
SUPABASE_SECRET_KEY=your-secret-key
SUPABASE_SCHEMA=spes

# ── Portal SSO Integration ────────────────────────────────────
PORTAL_SSO_CONSUME_URL=https://dole-portal.vercel.app/api/sso/consume
PORTAL_SSO_CLIENT_SECRET=your-portal-sso-client-secret
